{
  "manifest_version": 3,
  "name": "AIDetector.cx - AI Detector & Humanizer",
  "version": "1.0.9",
  "description": "AI Detector for ChatGPT, Gemini & Claude. Check AI text & humanize in Chrome. Auto-fill page text or paste content | AIDetector.cx.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AIDetector.cx",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.aidetector.cx/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": [
        "sync.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
